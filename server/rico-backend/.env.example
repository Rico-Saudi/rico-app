NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/rico
PORT=3000
SESSION_SECRET=replace_with_a_long_random_secret
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace_with_a_strong_password
GOOGLE_PLACES_API_KEY=replace_with_a_google_places_new_api_key
GOOGLE_PLACES_MONTHLY_CAP=200
GOOGLE_SYNC_COOLDOWN_DAYS=30
# Place Photos bills separately from search ($7/1,000, first 1,000/month free).
# Its own counter and cap so a photo-heavy month can't starve search itself.
GOOGLE_PHOTOS_MONTHLY_CAP=1000
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
RESEND_API_KEY=replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Rico <onboarding@resend.dev>
