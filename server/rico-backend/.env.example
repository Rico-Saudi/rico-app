NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/rico
PORT=3000
SESSION_SECRET=replace_with_a_long_random_secret
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace_with_a_strong_password
GOOGLE_PLACES_API_KEY=replace_with_a_google_places_new_api_key
GOOGLE_PLACES_MONTHLY_CAP=200
GOOGLE_SYNC_COOLDOWN_DAYS=30
# Place Photos bills separately from search ($7/1,000, first 1,000/month free).
# Its own counter and cap so a photo-heavy month can't starve search itself.
GOOGLE_PHOTOS_MONTHLY_CAP=1000
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_API_KEY=
RESEND_API_KEY=replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Rico <onboarding@resend.dev>

# --- Which LLM answers /classify and /compose -------------------------------
# Unset (or 'groq') keeps the behaviour this app has always had. Set to
# 'openrouter' to reach many models behind one key, with automatic failover.
LLM_PROVIDER=groq
# OPENROUTER_API_KEY=
# Models in priority order. OpenRouter fails over down the list within a single
# request on rate limits, downtime, context overflow or a moderation refusal,
# and bills whichever model actually answered.
# Classification wants reasoning (a wrong intent sends the user to the wrong
# place); composition wants speed (its 5s client timeout silently falls back to
# a fixed template). Hence two chains.
# OPENROUTER_CLASSIFY_MODELS=google/gemini-3-flash,groq/llama-3.3-70b
# OPENROUTER_COMPOSE_MODELS=groq/llama-3.3-70b,google/gemini-3-flash-lite
# Used when neither of the two above is set.
# OPENROUTER_MODEL=
# OPENROUTER_SITE_URL=https://app.rico-go.com

# --- Teaching Rico what it failed to answer --------------------------------
# Every question Rico could not turn into an intent is logged, and every this
# many hours it reads the most-asked of them and proposes a lesson for each:
# a teaching example, a missing trade, or "this is not ours to answer".
# Nothing reaches a user before the owner approves it in the dashboard.
# 0 disables the schedule; the dashboard's «درّب ريكو الآن» button still works.
# LEARNING_TRAIN_INTERVAL_HOURS=24

# --- Weather context -------------------------------------------------------
# The classic Current Weather endpoint: 60 calls/min and 1M/month free, no
# card. (One Call 3.0 is a separate metered product — not used.) Unset simply
# disables every weather behaviour: replies stop mentioning it and deals stop
# being reordered, and nothing else changes.
# Readings are cached per ~11km grid cell for 20 minutes, so call volume
# tracks areas being asked about rather than users asking.
# OPENWEATHER_API_KEY=

# --- Offer scraping (ScraperAPI) -------------------------------------------
# Reads published offers off retailer pages named by the platform owner.
# Unset disables it entirely; nothing else changes.
#
# Read src/scraping/scraping.constants.ts before enabling. Offers collected
# this way are not vendor-confirmed: they are labelled as such in the app,
# rank below vendor deals, and expire after 3 days on their own.
#
# Credits, not requests: a plain page is 1, JavaScript rendering 10. The free
# grant is 1,000 credits, i.e. ~100 rendered pages in total.
# SCRAPER_API_KEY=
# SCRAPER_MONTHLY_CREDITS=1000
# SCRAPER_COUNTRY_CODE=sa

# --- Instagram offer import (vendor-authorised) -----------------------------
# A vendor connects their OWN Instagram account and their offer posts become
# deals. Unlike scraping, this reads captions — because the account holder
# authorised it — and stops the moment they disconnect.
#
# Requires a Meta app using "Instagram API with Instagram Login" and App
# Review for instagram_business_basic before real vendors can connect. Unset
# disables the feature and the dashboard says so.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://app.rico-go.com/vendor/instagram/callback
